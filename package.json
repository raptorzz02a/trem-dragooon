{
  "name": "trem-dragooon",
  "version": "0.1.0",
  "private": true,
  "description": "Application de comptage de points aux fléchettes en mode kiosque",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc -p server/tsconfig.json && vite build",
    "build:borne": "tsc --noEmit && vite build --mode borne",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "online:dev": "vite build && wrangler dev -c server/wrangler.toml",
    "deploy": "npm run build && wrangler deploy -c server/wrangler.toml",
    "pont": "node bridge/pont-yeelight.mjs",
    "recette:ampoule": "node scripts/recette-ampoule.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
